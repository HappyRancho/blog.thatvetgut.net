{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Clinical and educational veterinary article published on ThatVetGuy",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique article identifier"
        },
        "title": {
          "type": "string",
          "description": "Headline of the article",
          "maxLength": 300
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary sub-headline or clinical summary",
          "maxLength": 500
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "description": "Full HTML or markdown article body content"
        },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"],
          "description": "Editorial workflow lifecycle state"
        },
        "authorId": {
          "type": "string",
          "description": "Author identifier"
        },
        "authorName": {
          "type": "string",
          "description": "Author display name"
        },
        "category": {
          "type": "string",
          "description": "Primary clinical category slug"
        },
        "tags": {
          "type": "array",
          "description": "List of associated clinical tags"
        },
        "featuredImage": {
          "type": "string",
          "description": "URL of lead article cover photo"
        },
        "publishedDate": {
          "type": "string",
          "description": "ISO timestamp when published"
        },
        "updatedDate": {
          "type": "string",
          "description": "ISO timestamp when last updated"
        },
        "excerpt": {
          "type": "string",
          "description": "Concise summary for previews and social sharing"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modified ISO timestamp"
        },
        "publishedAt": {
          "type": "string",
          "description": "Publishing ISO timestamp"
        },
        "seoTitle": {
          "type": "string",
          "description": "Custom SEO meta title"
        },
        "seoDescription": {
          "type": "string",
          "description": "Custom SEO meta description"
        },
        "canonicalUrl": {
          "type": "string",
          "description": "Canonical URL for original publisher attribution"
        },
        "sourceUrl": {
          "type": "string",
          "description": "Original source URL if imported"
        },
        "sourcePlatform": {
          "type": "string",
          "description": "Source platform name"
        },
        "importedAt": {
          "type": "string",
          "description": "Timestamp when imported"
        },
        "importedBy": {
          "type": "string",
          "description": "Author ID who imported"
        }
      },
      "required": ["id", "title", "slug", "content", "status", "authorId"]
    },
    "Author": {
      "title": "Author",
      "description": "ThatVetGuy Co-Founder clinical author profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique author slug identifier"
        },
        "name": {
          "type": "string",
          "description": "Full name with Dr. prefix"
        },
        "role": {
          "type": "string",
          "description": "Role, always CO_FOUNDER"
        },
        "designation": {
          "type": "string",
          "description": "Co-Founder, ThatVetGuy"
        },
        "professionalRole": {
          "type": "string",
          "description": "Clinical specialty role"
        },
        "qualifications": {
          "type": "string",
          "description": "Veterinary degrees"
        },
        "bio": {
          "type": "string",
          "description": "Short bio"
        },
        "fullBio": {
          "type": "string",
          "description": "Full bio"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Profile photo URL"
        },
        "clinicOrAffiliation": {
          "type": "string",
          "description": "Clinic or affiliation"
        },
        "expertise": {
          "type": "array",
          "description": "List of clinical expertise areas"
        }
      },
      "required": ["id", "name", "role"]
    },
    "CMSUser": {
      "title": "CMSUser",
      "description": "Authorized ThatVetGuy Co-Founder CMS identity",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID"
        },
        "email": {
          "type": "string",
          "description": "Co-Founder email address"
        },
        "authorId": {
          "type": "string",
          "description": "Associated author profile ID"
        },
        "role": {
          "type": "string",
          "description": "CO_FOUNDER"
        }
      },
      "required": ["uid", "email", "authorId", "role"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of veterinary articles and clinical guides"
    },
    "/authors/{authorId}": {
      "schema": "Author",
      "description": "Collection of the six Co-Founder author profiles"
    },
    "/cms_users/{userId}": {
      "schema": "CMSUser",
      "description": "Authorized CMS user associations"
    }
  }
}
