rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Explicit authorized Co-Founder email roster
    function isCoFounderEmail() {
      return isAuthenticated() && request.auth.token.email in [
        'chiragpatidar0369@gmail.com', 'chirag@thatvetguy.net', 'drchiragpatidar@gmail.com',
        'amaan@thatvetguy.net', 'amaan.ahmed@thatvetguy.net',
        'shivam@thatvetguy.net', 'shivam.singh@thatvetguy.net',
        'ritesh@thatvetguy.net', 'ritesh.verma@thatvetguy.net',
        'deepesh.mathur@thatvetguy.net', 'deepesh.chaware@thatvetguy.net'
      ];
    }

    function isRegisteredCmsUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/cms_users/$(request.auth.uid));
    }

    function isAuthorizedCMSUser() {
      return isCoFounderEmail() || isRegisteredCmsUser();
    }

    // Public can ONLY read published articles. Drafts are private to authorized CMS users.
    match /articles/{articleId} {
      allow read: if resource.data.status == 'PUBLISHED' || isAuthorizedCMSUser();
      allow create, update, delete: if isAuthorizedCMSUser();
    }

    // Public reads authors; only authorized Co-Founders can write/update author profiles.
    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    // CMS user mappings
    match /cms_users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAuthorizedCMSUser());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAuthorizedCMSUser());
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
