rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // A CMS account must be tied to the verified Firebase phone number.  Do not
    // rely on a client-created cms_users document alone: a signed-in user could
    // otherwise grant themselves the CO_FOUNDER role.
    function hasApprovedPhone() {
      return isAuthenticated() &&
        request.auth.token.phone_number != null &&
        exists(/databases/$(database)/documents/authorized_phones/$(request.auth.token.phone_number)) &&
        get(/databases/$(database)/documents/authorized_phones/$(request.auth.token.phone_number)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/authorized_phones/$(request.auth.token.phone_number)).data.role == 'CO_FOUNDER';
    }

    // Explicit verification: Firebase UID, verified allowlisted phone, and an
    // active CMS record bound to that phone's author record.
    function isAuthorizedCMSUser() {
      return hasApprovedPhone() &&
        exists(/databases/$(database)/documents/cms_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/cms_users/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/cms_users/$(request.auth.uid)).data.role == 'CO_FOUNDER' &&
        get(/databases/$(database)/documents/cms_users/$(request.auth.uid)).data.authorId ==
          get(/databases/$(database)/documents/authorized_phones/$(request.auth.token.phone_number)).data.authorId;
    }

    // Protected phone allowlist:
    // Individual get permitted so the login flow can check authorization before sending OTP.
    // Each approved record must use the normalized E.164 number as its document ID.
    // Listing the collection is strictly FORBIDDEN to prevent enumerating or scraping phone numbers
    // Modifying the collection from client is strictly FORBIDDEN
    match /authorized_phones/{phoneId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // CMS user records keyed by Firebase UID
    match /cms_users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAuthorizedCMSUser());
      allow list: if isAuthorizedCMSUser();
      allow create: if hasApprovedPhone() && request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.phoneNumber == request.auth.token.phone_number &&
        request.resource.data.authorId ==
          get(/databases/$(database)/documents/authorized_phones/$(request.auth.token.phone_number)).data.authorId &&
        request.resource.data.role == 'CO_FOUNDER' &&
        request.resource.data.status == 'ACTIVE';
      allow update: if hasApprovedPhone() && request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.phoneNumber == resource.data.phoneNumber &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    // Public can ONLY read published articles. Drafts are private to authorized CMS users.
    match /articles/{articleId} {
      allow read: if resource.data.status == 'PUBLISHED' || isAuthorizedCMSUser();
      allow create, update, delete: if isAuthorizedCMSUser();
    }

    // Public reads authors; only authorized Co-Founders can write/update author profiles.
    match /authors/{authorId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAuthorizedCMSUser();
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
