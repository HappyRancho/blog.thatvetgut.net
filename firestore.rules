rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Keep this roster in sync with APPROVED_EMAILS_MAP in the client. Do not
    // authorize an entire email domain: a domain account is not a CMS role.
    function isCoFounderEmail() {
      return isAuthenticated() && request.auth.token.email in [
        'chiragpatidar0369@gmail.com', 'chirag@thatvetguy.net', 'drchiragpatidar@gmail.com',
        'amaan@thatvetguy.net', 'amaan.ahmed@thatvetguy.net',
        'shivam@thatvetguy.net', 'shivam.singh@thatvetguy.net',
        'ritesh@thatvetguy.net', 'ritesh.verma@thatvetguy.net',
        'deepesh.mathur@thatvetguy.net', 'deepesh.chaware@thatvetguy.net'
      ];
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isCoFounder() {
      return isCoFounderEmail() ||
        (userDocExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CO_FOUNDER');
    }

    function isContributor() {
      return isAuthenticated() && userDocExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CONTRIBUTOR';
    }

    match /articles/{articleId} {
      allow read: if resource.data.status == 'PUBLISHED' || isCoFounder() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isCoFounder() || isContributor();
      allow update: if isCoFounder() || (isContributor() && resource.data.authorId == request.auth.uid && request.resource.data.status != 'PUBLISHED');
      allow delete: if isCoFounder();
    }

    match /users/{userId} {
      allow read: if true;
      // A user may only create/update their UID-keyed profile after their
      // allowlisted Google login; other user records are founder-managed.
      allow create, update: if isCoFounder() || (isCoFounderEmail() && request.auth.uid == userId);
      allow delete: if isCoFounder();
    }

    match /categories/{categoryId} { allow read: if true; allow write: if isCoFounder(); }
    match /tags/{tagId} { allow read: if true; allow write: if isCoFounder(); }

    match /audit_logs/{logId} {
      allow read: if isCoFounder();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /test/{docId} { allow read: if true; }
  }
}
