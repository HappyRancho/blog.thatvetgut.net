rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isCoFounder() {
      return isAuthenticated() && (
        request.auth.token.email == 'chiragpatidar0369@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@thatvetguy[.]net')) ||
        (userDocExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CO_FOUNDER')
      );
    }
    
    function isContributor() {
      return isAuthenticated() && (
        userDocExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CONTRIBUTOR'
      );
    }

    // Articles collection
    match /articles/{articleId} {
      allow read: if resource.data.status == 'PUBLISHED' || isCoFounder() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isCoFounder() || isContributor();
      allow update: if isCoFounder() || (isContributor() && resource.data.authorId == request.auth.uid && request.resource.data.status != 'PUBLISHED');
      allow delete: if isCoFounder();
    }

    // Users / Authors profile collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isCoFounder() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isCoFounder();
    }

    // Categories & Tags
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isCoFounder();
    }
    
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isCoFounder();
    }

    // CMS Audit Logs
    match /audit_logs/{logId} {
      allow read: if isCoFounder();
      allow create: if isAuthenticated() || isCoFounder();
      allow update, delete: if false; // Audit logs are strictly immutable
    }
  }
}
