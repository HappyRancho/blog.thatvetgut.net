{
  "name": "thatvetguy-publication",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/worker-config.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/domain.test.ts",
    "test:rules": "firebase emulators:exec --project demo-thatvetguy --only firestore 'node --test tests/rules.test.mjs'",
    "check": "tsc -b",
    "deploy": "npm run build && node --env-file-if-exists=.env.local scripts/deploy.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src worker docs tests scripts *.json *.ts README.md .github/workflows",
    "lint": "prettier --check src worker docs tests scripts *.json *.ts README.md .github/workflows",
    "test:worker": "node --experimental-strip-types --test tests/worker.test.mjs",
    "test:cms": "firebase emulators:exec --project demo-thatvetguy --only firestore,auth 'node tests/cms-browser.mjs'"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "firebase": "12.4.0",
    "dompurify": "3.2.7",
    "lucide-react": "0.468.0",
    "fuse.js": "7.1.0",
    "@tailwindcss/vite": "4.1.14",
    "tailwindcss": "4.1.14",
    "@tiptap/react": "2.11.5",
    "@tiptap/starter-kit": "2.11.5",
    "@tiptap/extension-link": "2.11.5",
    "@tiptap/extension-image": "2.11.5",
    "@tiptap/extension-placeholder": "2.11.5",
    "@tiptap/extension-table": "2.11.5",
    "@tiptap/extension-table-row": "2.11.5",
    "@tiptap/extension-table-header": "2.11.5",
    "@tiptap/extension-table-cell": "2.11.5",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "22.14.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "firebase-tools": "14.19.1",
    "@firebase/rules-unit-testing": "5.0.0",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "@types/sanitize-html": "2.16.0",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=22"
  }
}
